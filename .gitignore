# 1. 忽略编译产物（Java）
# 忽略整个 target 目录（Maven/Gradle 编译输出）
target/
# IDEA 编译输出目录
out/
# 忽略所有 .class 字节码文件
*.class

# 2. 忽略 IDE 配置文件
# IDEA 配置目录
.idea/
# IDEA 项目文件
*.iml
# VSCode 配置目录
.vscode/
# Eclipse 配置目录
.settings/
# Eclipse 项目文件
.project
# Eclipse 类路径文件
.classpath

# 3. 忽略依赖/缓存文件
# Node.js 依赖（前端项目用）
node_modules/
# Maven 本地缓存（可选）
.m2/
# Gradle 缓存
.gradle/
# Vue/Vite 编译输出目录
dist/

# 4. 忽略日志/临时文件
# 所有 .log 日志文件
*.log
# 日志目录
logs/
# 临时文件
*.tmp
# 备份文件
*.bak

# 5. 忽略配置文件（敏感信息/本地配置）
# 本地开发配置
src/main/resources/application-dev.yml
# 若有敏感信息可忽略
src/main/resources/application.properties
# 环境变量文件
.env
# Vue 环境变量文件
.env.*.local

# 6. 忽略系统文件
# Mac 系统文件
.DS_Store
# Windows 系统文件
Thumbs.db
